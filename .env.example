# WhatsApp Bot Configuration
BOT_NAME=WhatsApp Tracker Bot
BOT_DESCRIPTION=Automated WhatsApp chatbot with Google Sheets integration

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_CREDENTIALS_PATH=./config/google-credentials.json

# Bot Settings
AUTO_REPLY_ENABLED=true
TRACK_ALL_MESSAGES=true
TRACK_FIRST_CONTACT=true
TRACK_RESPONSE_TIME=true

# Server Configuration (optional - for webhook/status endpoint)
PORT=3000
ENABLE_WEB_INTERFACE=false

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/bot.log

# Message Templates
WELCOME_MESSAGE=Hello! 👋 Welcome to our automated support system. How can I help you today?
FIRST_TIME_MESSAGE=Thank you for contacting us for the first time! We've recorded your information and will get back to you soon.
AUTO_REPLY_MESSAGE=Thank you for your message! We've received it and will respond as soon as possible.

# Business Hours (24-hour format)
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=17
BUSINESS_DAYS=1,2,3,4,5
TIMEZONE=Asia/Jakarta
